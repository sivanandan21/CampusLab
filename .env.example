# ==============================================================================
# CampusLab Environment Configuration Template
# APJ Abdul Kalam Technological University (KTU) 2024 Scheme - B.Tech CSE
# ==============================================================================

# Application Environment
APP_ENV=development                          # development | staging | production
APP_NAME="CampusLab Backend (KTU 2024 Scheme)"
DEBUG=true

# AWS Configuration (ap-south-1 Mumbai)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=                           # Optional in local dev, injected via IAM in AWS
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_ARTIFACT_BUCKET=campuslab-artifacts-ap-south-1
S3_ENDPOINT_URL=                             # Set to http://localhost:4566 for LocalStack
CLOUDWATCH_NAMESPACE=CampusLab/Pilot
STS_SANDBOX_ROLE_ARN=arn:aws:iam::123456789012:role/CampusLabStudentSandboxRole

# Security & Secrets
APP_SECRET_KEY=campuslab_master_secret_key_ktu_2024_pilot_testing_only_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440             # 24 Hours
SESSION_TOKEN_EXPIRE_MINUTES=45
WORKER_SHARED_SECRET=worker_hmac_shared_secret_campuslab_ktu2024

# Database Connection
# SQLite local dev fallback: sqlite+aiosqlite:///./campuslab.db
# PostgreSQL RDS: postgresql+asyncpg://postgres:postgres@localhost:5432/campuslab
DATABASE_URL=sqlite+aiosqlite:///./campuslab.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Worker Communication (Internal VPC)
WORKER_API_URL=http://localhost:8001
SESSION_TTL_MINUTES=45

# Frontend Connection
VITE_API_URL=http://localhost:8000/api/v1
VITE_USE_MOCK_API=true                       # Set to false to connect directly to FastAPI
