# ==============================================================================
# CampusLab Git Ignore
# ==============================================================================

# Node / Frontend
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Database & Local Run
*.db
*.sqlite3
campuslab.db

# Environment & Secrets (NEVER commit live secrets)
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# IDEs & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
